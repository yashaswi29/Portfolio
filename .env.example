# Copy to .env and fill in real values. .env is gitignored — never commit secrets.
#
# Contact-form email notifications. Leave SMTP_* empty to disable email
# (submissions still save to the backend data volume).
# For Gmail: enable 2-Step Verification, then create an App Password (Mail).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
CONTACT_NOTIFY_TO=you@gmail.com
CONTACT_NOTIFY_FROM=you@gmail.com

# Optional: comma-separated CORS origins (defaults to the portfolio domains).
# CORS_ALLOW_ORIGINS=https://yashaswi.space,https://www.yashaswi.space
